# ====================================================================
# DataGalactic LeadPilot AI — Environment Configuration (.env.example)
# ====================================================================

# 1. Server Configuration
PORT=5005

# ====================================================================
# 2. REAL-TIME EMAIL OTP VERIFICATION (Nodemailer / SMTP)
# --------------------------------------------------------------------
# Configure either Option A or Option B to send real OTP verification emails
# ====================================================================

# --- OPTION A: Free Gmail App Password ---
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASS=your-16-char-app-password

# --- OPTION B: Custom Domain SMTP (Titan, Zoho, Brevo, SendGrid, Hostinger) ---
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=contact@datagalactic.com
SMTP_PASS=your-smtp-password

# Email Sender Name & Address
EMAIL_FROM="LeadPilot AI <no-reply@datagalactic.com>"

# ====================================================================
# 3. EXTERNAL AI & LEAD SOURCING APIS (Optional)
# ====================================================================

# Google Gemini AI Key (Free from: https://aistudio.google.com/)
GEMINI_API_KEY=

# Apollo.io B2B Intelligence Key (Free from: https://www.apollo.io/)
APOLLO_API_KEY=

# Hunter.io Email Verification Key (Free from: https://hunter.io/)
HUNTER_API_KEY=

# Supabase Cloud Database (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
